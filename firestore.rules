rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: check if the caller is a verified admin ──────────────
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── users/{uid} ───────────────────────────────────────────────────
    // Any signed-in user can read their own doc.
    // Only the backend (admin SDK) or the user themselves can write.
    match /users/{uid} {
      allow read:  if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == uid || isAdmin() || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'hospital' && request.auth.uid in resource.data.affiliatedHospitals));
      allow create, delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // ── patients/{healthId} ───────────────────────────────────────────
    // Patient can read/write their own profile (matched by uid inside doc)
    // ANY authenticated user can read (needed for Hospital/Doctor search feature)
    match /patients/{healthId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        resource.data.personalInfo.uid == request.auth.uid;

      // Sub-collection: records
      match /records/{recordId} {
        // Patient can read ALL their own records; doctors/hospitals can read records they created
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/patients/$(healthId)).data.personalInfo.uid == request.auth.uid ||
          isAdmin() ||
          resource.data.hospitalId == request.auth.uid ||
          resource.data.doctorId == request.auth.uid
        );
        // Any authenticated user (hospital/doctor) can create records for a patient
        allow create: if request.auth != null;
        // Only the patient or admin can update/delete
        allow update, delete: if request.auth != null && (
          get(/databases/$(database)/documents/patients/$(healthId)).data.personalInfo.uid == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // ── doctors/{uid} ─────────────────────────────────────────────────
    match /doctors/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── hospitals/{uid} ───────────────────────────────────────────────
    match /hospitals/{uid} {
      allow read:  if true;
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // ── laboratories/{uid} ────────────────────────────────────────────
    match /laboratories/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // ── accessLinks/{linkId} ──────────────────────────────────────────
    // Patient can read their own links; hospitals/labs can create requests
    match /accessLinks/{linkId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && isAdmin();
    }

    // ── appointments/{apptId} ─────────────────────────────────────────
    match /appointments/{apptId} {
      // Any authenticated user can read (patient queries by healthId, doctor by doctorId)
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // ── ads / advertisements ──────────────────────────────────────────
    match /advertisements/{adId} {
      allow read:   if true; // Ads are public
      allow write:  if request.auth != null;
    }

    // ── Deny everything else by default ──────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
